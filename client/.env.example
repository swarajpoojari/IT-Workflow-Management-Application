# ─────────────────────────────────────────────────────────────
# IT Workflow Management System — client environment
# Copy to `.env` (`cp .env.example .env`) if you need to override.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ─────────────────────────────────────────────────────────────

# Base URL of the API. Leave as-is to use the dev-server proxy in
# vite.config.js (recommended: same-origin requests, so the refresh cookie
# is sent without any CORS/SameSite configuration).
VITE_API_BASE_URL=/api

# Point directly at the API instead — requires the server's CORS_ORIGIN to
# list this app's origin and credentials to be allowed.
# VITE_API_BASE_URL=http://localhost:4000/api
