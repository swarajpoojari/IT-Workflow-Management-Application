# ─────────────────────────────────────────────────────────────
# IT Workflow Management System — server environment
# Copy to `.env` (`cp .env.example .env`) before running.
# Every value below has a safe development default in src/config/env.js,
# so the app boots with an empty .env — but NEVER ship these secrets.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# Database — SQLite file path, relative to the server/ folder.
# Swap the driver in src/db/index.js for Postgres/MySQL; the schema is portable SQL.
DATABASE_URL=./data/itwf.sqlite

# JWT secrets — MUST be changed for any non-local deployment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# The refresh token travels in an httpOnly cookie. Name + flags:
REFRESH_COOKIE_NAME=itwf_refresh
# "true" only when the API is served over HTTPS (production).
COOKIE_SECURE=false
# lax | strict | none  ("none" requires COOKIE_SECURE=true for cross-site clients)
COOKIE_SAMESITE=lax

# CORS — comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Seed script: password given to every generated demo user.
SEED_PASSWORD=Passw0rd!

# Rate limiting on /api/auth/login (brute-force protection)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
